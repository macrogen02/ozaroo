<header id="SiteHeader" class="site-header" data-site-header>
  <div class="page-width header-inner">
    <button class="header-icon header-icon--menu" type="button" aria-expanded="false" aria-controls="MobileMenu" data-menu-toggle>
      <span class="visually-hidden">Open menu</span>
      <span aria-hidden="true">☰</span>
    </button>

    <div class="header-brand">
      {% render 'logo' %}
    </div>

    <a class="header-deliver" href="{{ section.settings.deliver_to_link | default: routes.root_url }}" aria-label="Deliver to location">
      <span class="header-deliver-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" focusable="false"><path d="M12 2.8c-3.7 0-6.7 3-6.7 6.7 0 4.8 6.7 11.7 6.7 11.7s6.7-6.9 6.7-11.7c0-3.7-3-6.7-6.7-6.7Zm0 9.3a2.6 2.6 0 1 1 0-5.2 2.6 2.6 0 0 1 0 5.2Z" fill="currentColor"/></svg>
      </span>
      <span>{{ section.settings.deliver_to_label }}</span>
    </a>

    <form class="header-search" action="{{ routes.search_url }}" method="get" role="search">
      <label class="visually-hidden" for="HeaderSearch">Search products</label>
      <span class="header-search-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" focusable="false"><path d="M10.3 4a6.3 6.3 0 1 0 3.9 11.2l4 4a.9.9 0 0 0 1.3-1.3l-4-4A6.3 6.3 0 0 0 10.3 4Zm0 10.9a4.6 4.6 0 1 1 0-9.2 4.6 4.6 0 0 1 0 9.2Z" fill="currentColor"/></svg>
      </span>
      <input id="HeaderSearch" type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search products" aria-label="Search products">
      <button type="submit" class="header-search-submit" aria-label="Submit search">Search</button>
    </form>

    <nav class="header-actions" aria-label="Customer shortcuts">
      <a href="{{ routes.account_url }}" class="header-icon header-icon--action" aria-label="Account">
        <span class="header-action-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" focusable="false"><path d="M12 12.4A4.7 4.7 0 1 0 12 3a4.7 4.7 0 0 0 0 9.4Zm0-7.7a3 3 0 1 1 0 6 3 3 0 0 1 0-6Zm0 9.4c-4.3 0-7.8 2.8-7.8 6.3 0 .5.4.9.9.9h13.8c.5 0 .9-.4.9-.9 0-3.5-3.5-6.3-7.8-6.3Zm-6 5.4c.5-2.1 2.9-3.7 6-3.7s5.5 1.6 6 3.7H6Z" fill="currentColor"/></svg>
        </span>
        <span>Account</span>
      </a>
      <button class="header-icon header-icon--action" type="button" aria-expanded="false" aria-controls="CartDrawer" data-cart-toggle>
        <span class="header-action-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" focusable="false"><path d="M8.2 6.2h11.3a.9.9 0 0 1 .9 1.1l-1.6 7a.9.9 0 0 1-.9.7H10a.9.9 0 0 1-.9-.7L7.3 4.8H4.5a.9.9 0 0 1 0-1.8H8a.9.9 0 0 1 .9.7l.3 1.6Zm1.6 7h7.3l1.2-5.2H8.8l1 5.2Zm.3 7.8a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3Zm7.3 0a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3Z" fill="currentColor"/></svg>
        </span>
        <span>Cart</span>
        <span class="cart-count" data-cart-count>{{ cart.item_count }}</span>
      </button>
    </nav>
  </div>

  <nav id="MobileMenu" class="mobile-menu" aria-label="Mobile">
    <ul class="mobile-menu-list" role="list">
      {% for link in section.settings.menu.links %}
        <li><a href="{{ link.url }}">{{ link.title }}</a></li>
      {% endfor %}
      <li><a href="{{ section.settings.deliver_to_link | default: routes.root_url }}">{{ section.settings.deliver_to_label }}</a></li>
    </ul>
  </nav>

  <aside id="CartDrawer" class="cart-drawer" aria-label="Cart drawer" aria-hidden="true">
    <div class="cart-drawer-header">
      <h2>Your cart</h2>
      <button type="button" data-cart-toggle aria-label="Close cart">×</button>
    </div>
    {% if cart.item_count > 0 %}
      <ul class="cart-items" role="list">
        {% for item in cart.items %}
          <li>
            <a href="{{ item.url }}">{{ item.product.title }}</a>
            <span>{{ item.quantity }} × {{ item.final_price | money }}</span>
          </li>
        {% endfor %}
      </ul>
      <a class="button button--coral" href="{{ routes.cart_url }}">Checkout</a>
    {% else %}
      <p>Your cart is empty.</p>
    {% endif %}
  </aside>
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu"
    },
    {
      "type": "text",
      "id": "deliver_to_label",
      "label": "Deliver to label",
      "default": "Deliver to"
    },
    {
      "type": "url",
      "id": "deliver_to_link",
      "label": "Deliver to link"
    }
  ]
}
{% endschema %}
