<header class="ozh-header ozh-sticky-target" role="banner" data-oz-header>
  <div class="page-width ozh-header__inner">
    <div class="ozh-header__left">
      <button class="ozh-mobile-trigger" type="button" data-mobile-toggle aria-expanded="false" aria-controls="MobileDrawer" aria-label="Open mobile menu">
        <svg viewBox="0 0 24 24" focusable="false" aria-hidden="true"><path d="M4 6h16v2H4V6Zm0 5h16v2H4v-2Zm0 5h16v2H4v-2Z" fill="currentColor"/></svg>
      </button>

      <a href="{{ routes.root_url }}" class="ozh-logo" aria-label="ozaroo home">
        {% render 'logo' %}
      </a>

      <button class="ozh-category-trigger" type="button" data-category-overlay-toggle aria-expanded="false" aria-controls="CategoryOverlay">
        <svg viewBox="0 0 24 24" focusable="false" aria-hidden="true"><path d="M4 6h16v2H4V6Zm0 5h16v2H4v-2Zm0 5h16v2H4v-2Z" fill="currentColor"/></svg>
        <span>Shop by Category</span>
      </button>

      {% if section.settings.show_delivery_selector %}
        <button class="ozh-delivery-pill" type="button" data-delivery-toggle aria-expanded="false" aria-controls="DeliveryInfo">
          <span>Delivery to Melbourne 3000</span>
        </button>
      {% endif %}
    </div>

    <div class="ozh-header__center">
      {% render 'header-search', section: section %}
    </div>

    <div class="ozh-header__right">
      {% render 'header-icons' %}
    </div>
  </div>

  {% render 'mega-menu', section: section %}
  {% render 'mobile-menu', section: section %}

  {% if section.settings.show_delivery_selector %}
    <div class="ozh-delivery-dropdown" id="DeliveryInfo" hidden>
      <p>Delivery to Melbourne 3000</p>
      <p>Arrives in 2–4 days</p>
    </div>
  {% endif %}

  {% if section.settings.enable_category_overlay %}
    <div class="ozh-category-overlay" id="CategoryOverlay" hidden>
      <div class="ozh-category-overlay__head">
        <h2>Shop by Category</h2>
        <button type="button" data-category-overlay-toggle aria-label="Close category panel">×</button>
      </div>
      <div class="ozh-category-overlay__grid">
        {% for block in section.blocks %}
          {% if block.type == 'overlay_category' %}
            <a href="{{ block.settings.link | default: '/collections/all' }}" class="ozh-category-tile" {{ block.shopify_attributes }}>
              <span aria-hidden="true">{{ block.settings.icon }}</span>
              <span>{{ block.settings.label }}</span>
            </a>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  {% endif %}
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_delivery_selector",
      "label": "Show delivery selector",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_predictive_search",
      "label": "Enable predictive search panel",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_category_overlay",
      "label": "Enable category overlay",
      "default": true
    },
    {
      "type": "link_list",
      "id": "categories_menu",
      "label": "Categories menu"
    },
    {
      "type": "link_list",
      "id": "support_menu",
      "label": "Support links menu"
    },
    {
      "type": "link_list",
      "id": "company_menu",
      "label": "Company links menu"
    },
    {
      "type": "link_list",
      "id": "mega_menu",
      "label": "Mega menu links"
    },
    {
      "type": "textarea",
      "id": "mega_promo_text",
      "label": "Mega menu promo text",
      "default": "Discover curated deals and fast delivery across Australia's most-loved categories."
    },
    {
      "type": "image_picker",
      "id": "mega_banner",
      "label": "Mega menu banner image"
    }
  ],
  "blocks": [
    {
      "type": "search_category",
      "name": "Search category option",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Electronics"
        }
      ]
    },
    {
      "type": "overlay_category",
      "name": "Overlay category card",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Icon",
          "default": "📦"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Category"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Header",
      "blocks": [
        { "type": "search_category", "settings": { "label": "Electronics" } },
        { "type": "search_category", "settings": { "label": "Home & Living" } },
        { "type": "overlay_category", "settings": { "icon": "📱", "label": "Electronics" } },
        { "type": "overlay_category", "settings": { "icon": "🏠", "label": "Home & Living" } },
        { "type": "overlay_category", "settings": { "icon": "🧴", "label": "Health & Beauty" } },
        { "type": "overlay_category", "settings": { "icon": "🛒", "label": "Groceries" } }
      ]
    }
  ]
}
{% endschema %}
