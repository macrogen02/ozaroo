<header class="ozh-header ozh-sticky-target" role="banner" data-oz-header>
  <div class="page-width ozh-header__inner">
    <div class="ozh-header__left">
      <button class="ozh-mobile-trigger" type="button" data-mobile-toggle aria-expanded="false" aria-controls="MobileDrawer" aria-label="Open mobile menu">
        <svg viewBox="0 0 24 24" focusable="false" aria-hidden="true"><path d="M4 6h16v2H4V6Zm0 5h16v2H4v-2Zm0 5h16v2H4v-2Z" fill="currentColor"/></svg>
      </button>

      <a href="{{ routes.root_url }}" class="ozh-logo" aria-label="ozaroo home">
        {% render 'logo' %}
      </a>

      <button class="ozh-category-trigger" type="button" data-mega-toggle aria-expanded="false" aria-controls="HeaderMegaMenu">
        <svg viewBox="0 0 24 24" focusable="false" aria-hidden="true"><path d="M4 6h16v2H4V6Zm0 5h16v2H4v-2Zm0 5h16v2H4v-2Z" fill="currentColor"/></svg>
        <span>Shop by Category</span>
      </button>

      {% if section.settings.show_delivery_selector %}
        <div class="ozh-delivery-control" data-delivery-control>
          <button class="ozh-delivery-pill" type="button" data-delivery-toggle aria-expanded="false" aria-controls="DeliveryAddressInput" aria-label="Add your delivery address">
            <svg viewBox="0 0 24 24" focusable="false" aria-hidden="true"><path d="M3 7h11.5a1 1 0 0 1 .9.6l1 2.4h2.2c1 0 1.9.8 1.9 1.9V15h-1.6a2.9 2.9 0 0 0-5.8 0H10a2.9 2.9 0 0 0-5.8 0H3V8c0-.6.4-1 1-1Zm14.4 4.6-.7-1.7h1.7l1.2 1.7h-2.2ZM7.1 17.8a1.3 1.3 0 1 1 0-2.6 1.3 1.3 0 0 1 0 2.6Zm8.8 0a1.3 1.3 0 1 1 0-2.6 1.3 1.3 0 0 1 0 2.6Z" fill="currentColor"/></svg>
            <span class="ozh-delivery-pill__label">Fast delivery</span>
          </button>
          <div class="ozh-delivery-expand" id="DeliveryAddressInput" aria-hidden="true">
            <label for="DeliveryAddressField" class="visually-hidden">Preferred delivery address</label>
            <input id="DeliveryAddressField" type="text" name="delivery_address" placeholder="Enter preferred delivery address">
          </div>
        </div>
      {% endif %}
    </div>

    <div class="ozh-header__center">
      {% render 'header-search', section: section %}
    </div>

    <div class="ozh-header__right">
      {% render 'header-icons' %}
    </div>
  </div>

  {% render 'mega-menu', section: section %}
  {% render 'mobile-menu', section: section %}


</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_delivery_selector",
      "label": "Show delivery selector",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_predictive_search",
      "label": "Enable predictive search panel",
      "default": true
    },
    {
      "type": "link_list",
      "id": "categories_menu",
      "label": "Categories menu"
    },
    {
      "type": "link_list",
      "id": "support_menu",
      "label": "Support links menu"
    },
    {
      "type": "link_list",
      "id": "company_menu",
      "label": "Company links menu"
    },
    {
      "type": "link_list",
      "id": "mega_menu",
      "label": "Mega menu links"
    },
    {
      "type": "textarea",
      "id": "mega_promo_text",
      "label": "Mega menu promo text",
      "default": "Discover curated deals and fast delivery across Australia's most-loved categories."
    },
    {
      "type": "image_picker",
      "id": "mega_banner",
      "label": "Mega menu banner image"
    }
  ],
  "blocks": [
    {
      "type": "search_category",
      "name": "Search category option",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Electronics"
        }
      ]
    },
    {
      "type": "overlay_category",
      "name": "Overlay category card",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Icon",
          "default": "📦"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Category"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Header",
      "blocks": [
        { "type": "search_category", "settings": { "label": "Electronics" } },
        { "type": "search_category", "settings": { "label": "Home & Living" } },
        { "type": "overlay_category", "settings": { "icon": "📱", "label": "Electronics" } },
        { "type": "overlay_category", "settings": { "icon": "🏠", "label": "Home & Living" } },
        { "type": "overlay_category", "settings": { "icon": "🧴", "label": "Health & Beauty" } },
        { "type": "overlay_category", "settings": { "icon": "🛒", "label": "Groceries" } }
      ]
    }
  ]
}
{% endschema %}
