<section class="footer-trust-strip" aria-label="Trust and logistics highlights">
  {% if section.settings.show_trust_strip %}
    <div class="page-width footer-trust-strip__inner">
      <div class="trust-item">
        <span class="trust-item__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" focusable="false"><path d="M12 2 4 5v6c0 5 3.4 9.7 8 11 4.6-1.3 8-6 8-11V5l-8-3Zm0 2.2 6 2.2V11c0 4.1-2.6 8.1-6 9.3-3.4-1.2-6-5.2-6-9.3V6.4l6-2.2Z" fill="currentColor"/></svg>
        </span>
        <span>Australia-wide delivery</span>
      </div>
      <div class="trust-item">
        <span class="trust-item__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" focusable="false"><path d="M3 6h11v8H3V6Zm12 2h3l3 3v3h-6V8Zm1.5 10a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Zm-9 0a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Z" fill="currentColor"/></svg>
        </span>
        <span>Fast dispatch from local suppliers</span>
      </div>
      <div class="trust-item">
        <span class="trust-item__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" focusable="false"><path d="M2 6h20v12H2V6Zm2 2v2h16V8H4Zm0 4v4h8v-4H4Z" fill="currentColor"/></svg>
        </span>
        <span>Secure payments</span>
      </div>
      <div class="trust-item">
        <span class="trust-item__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" focusable="false"><path d="M12 2a7 7 0 0 0-7 7v4H3v7h18v-7h-2V9a7 7 0 0 0-7-7Zm-5 7a5 5 0 0 1 10 0v4H7V9Zm5 9a2 2 0 1 1 0-4 2 2 0 0 1 0 4Z" fill="currentColor"/></svg>
        </span>
        <span>Australian customer support</span>
      </div>
    </div>
  {% endif %}
</section>

{% schema %}
{
  "name": "Footer trust strip",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_trust_strip",
      "label": "Show trust strip",
      "default": true
    }
  ]
}
{% endschema %}
