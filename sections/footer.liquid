<footer class="site-footer" role="contentinfo">
  {% if section.settings.show_trust_strip %}
    <div class="footer-trust-strip" aria-label="Trust and logistics highlights">
      <div class="page-width footer-trust-strip__inner">
        <div class="trust-item">
          <span class="trust-item__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" focusable="false"><path d="M12 2 4 5v6c0 5 3.4 9.7 8 11 4.6-1.3 8-6 8-11V5l-8-3Zm0 2.2 6 2.2V11c0 4.1-2.6 8.1-6 9.3-3.4-1.2-6-5.2-6-9.3V6.4l6-2.2Z" fill="currentColor"/></svg>
          </span>
          <span>Australia-wide delivery</span>
        </div>
        <div class="trust-item">
          <span class="trust-item__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" focusable="false"><path d="M3 6h11v8H3V6Zm12 2h3l3 3v3h-6V8Zm1.5 10a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Zm-9 0a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Z" fill="currentColor"/></svg>
          </span>
          <span>Fast dispatch from local suppliers</span>
        </div>
        <div class="trust-item">
          <span class="trust-item__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" focusable="false"><path d="M2 6h20v12H2V6Zm2 2v2h16V8H4Zm0 4v4h8v-4H4Z" fill="currentColor"/></svg>
          </span>
          <span>Secure payments</span>
        </div>
        <div class="trust-item">
          <span class="trust-item__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" focusable="false"><path d="M12 2a7 7 0 0 0-7 7v4H3v7h18v-7h-2V9a7 7 0 0 0-7-7Zm-5 7a5 5 0 0 1 10 0v4H7V9Zm5 9a2 2 0 1 1 0-4 2 2 0 0 1 0 4Z" fill="currentColor"/></svg>
          </span>
          <span>Australian customer support</span>
        </div>
      </div>
    </div>
  {% endif %}

  <div class="footer-main">
    <div class="page-width footer-grid" aria-label="Footer navigation and newsletter">
      <section class="footer-column footer-brand" aria-labelledby="FooterBrandHeading">
        <h2 id="FooterBrandHeading" class="visually-hidden">Brand</h2>
        {% render 'logo' %}
        <p class="footer-tagline">Where Australia Shops.</p>
        <p class="footer-secondary">{{ section.settings.brand_description }}</p>
        <p class="footer-secondary">{{ section.settings.abn_text }}</p>
        <p class="footer-secondary">{{ section.settings.location_text }}</p>
      </section>

      <nav class="footer-column" aria-labelledby="FooterShopHeading">
        <h3 id="FooterShopHeading">Shop</h3>
        <ul role="list">
          {% if section.settings.shop_menu.links != blank %}
            {% for link in section.settings.shop_menu.links %}
              <li><a href="{{ link.url }}">{{ link.title }}</a></li>
            {% endfor %}
          {% else %}
            <li><a href="/collections">Browse Categories</a></li>
            <li><a href="/collections/all">Deals &amp; Offers</a></li>
            <li><a href="/collections/new-arrivals">New Arrivals</a></li>
            <li><a href="/collections/best-sellers">Best Sellers</a></li>
            <li><a href="/products/gift-card">Gift Cards</a></li>
          {% endif %}
        </ul>
      </nav>

      <nav class="footer-column" aria-labelledby="FooterSupportHeading">
        <h3 id="FooterSupportHeading">Customer support</h3>
        <ul role="list">
          {% if section.settings.support_menu.links != blank %}
            {% for link in section.settings.support_menu.links %}
              <li><a href="{{ link.url }}">{{ link.title }}</a></li>
            {% endfor %}
          {% else %}
            <li><a href="/pages/help-centre">Help Centre</a></li>
            <li><a href="/pages/track-order">Track Order</a></li>
            <li><a href="/pages/shipping">Shipping &amp; Delivery</a></li>
            <li><a href="/pages/returns">Returns &amp; Refunds</a></li>
            <li><a href="/pages/contact">Contact Us</a></li>
          {% endif %}
        </ul>
      </nav>

      <nav class="footer-column" aria-labelledby="FooterCompanyHeading">
        <h3 id="FooterCompanyHeading">Company</h3>
        <ul role="list">
          {% if section.settings.company_menu.links != blank %}
            {% for link in section.settings.company_menu.links %}
              <li><a href="{{ link.url }}">{{ link.title }}</a></li>
            {% endfor %}
          {% else %}
            <li><a href="/pages/about">About Ozaroo</a></li>
            <li><a href="/pages/careers">Careers</a></li>
            <li><a href="/pages/sell-on-ozaroo">Sell on Ozaroo</a></li>
            <li><a href="/pages/press">Press &amp; Media</a></li>
            <li><a href="/pages/sustainability">Sustainability</a></li>
          {% endif %}
        </ul>
      </nav>

      <section class="footer-column" aria-labelledby="FooterNewsletterHeading">
        <h3 id="FooterNewsletterHeading">Get deals, product drops, and exclusive offers.</h3>
        {% form 'customer', class: 'footer-newsletter-form' %}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <label class="visually-hidden" for="FooterNewsletterEmail">Email address</label>
          <input id="FooterNewsletterEmail" type="email" name="contact[email]" placeholder="Email address" required>
          <button type="submit" class="footer-subscribe-btn">Subscribe</button>
        {% endform %}
        <p class="footer-secondary">{{ section.settings.social_proof_text }}</p>
        <div class="footer-social" aria-label="Social media links">
          <a href="{{ section.settings.facebook_url | default: '#' }}" class="footer-social-link" aria-label="Facebook">
            <svg viewBox="0 0 24 24" focusable="false"><path d="M13.5 21v-7h2.3l.4-3h-2.7V9.2c0-.9.3-1.5 1.6-1.5h1.3V5.1c-.2 0-1-.1-2-.1-2.7 0-4.4 1.6-4.4 4.5V11H8v3h2.1v7h3.4Z" fill="currentColor"/></svg>
          </a>
          <a href="{{ section.settings.instagram_url | default: '#' }}" class="footer-social-link" aria-label="Instagram">
            <svg viewBox="0 0 24 24" focusable="false"><path d="M12 7.1A4.9 4.9 0 1 0 12 17a4.9 4.9 0 0 0 0-9.9Zm0 8.1a3.2 3.2 0 1 1 0-6.4 3.2 3.2 0 0 1 0 6.4Z" fill="currentColor"/><path d="M17.6 3.8H6.4A2.6 2.6 0 0 0 3.8 6.4v11.2a2.6 2.6 0 0 0 2.6 2.6h11.2a2.6 2.6 0 0 0 2.6-2.6V6.4a2.6 2.6 0 0 0-2.6-2.6Zm.9 13.8c0 .5-.4.9-.9.9H6.4a.9.9 0 0 1-.9-.9V6.4c0-.5.4-.9.9-.9h11.2c.5 0 .9.4.9.9v11.2Z" fill="currentColor"/></svg>
          </a>
          <a href="{{ section.settings.tiktok_url | default: '#' }}" class="footer-social-link" aria-label="TikTok">
            <svg viewBox="0 0 24 24" focusable="false"><path d="M14.8 4h2.8c.2 1.5 1.4 2.7 2.9 3v2.9c-1.2-.1-2.4-.5-3.5-1.2v5.7a5.4 5.4 0 1 1-5.4-5.4c.3 0 .7 0 1 .1V12a2.7 2.7 0 1 0 1.6 2.4V4Z" fill="currentColor"/></svg>
          </a>
        </div>
      </section>
    </div>
  </div>

  {% if section.settings.show_payment_row %}
    <div class="footer-payment-row">
      <div class="page-width footer-payment-row__inner" aria-label="Accepted payments and checkout security">
        {% render 'payment-icons' %}
        <p class="footer-payment-caption">Secure Checkout</p>
      </div>
    </div>
  {% endif %}

  <div class="footer-legal-strip">
    <div class="page-width footer-legal-strip__inner">
      <p>© {{ 'now' | date: '%Y' }} Ozaroo Pty Ltd</p>
      <p>Australia</p>
      <nav aria-label="Legal links">
        <ul role="list" class="footer-legal-links">
          {% if section.settings.legal_menu.links != blank %}
            {% for link in section.settings.legal_menu.links %}
              <li><a href="{{ link.url }}">{{ link.title }}</a></li>
            {% endfor %}
          {% else %}
            <li><a href="/policies/terms-of-service">Terms of Service</a></li>
            <li><a href="/policies/privacy-policy">Privacy Policy</a></li>
            <li><a href="/policies/refund-policy">Refund Policy</a></li>
            <li><a href="/pages/cookie-settings">Cookie Settings</a></li>
          {% endif %}
        </ul>
      </nav>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_trust_strip",
      "label": "Show trust strip",
      "default": true
    },
    {
      "type": "textarea",
      "id": "brand_description",
      "label": "Brand description",
      "default": "Ozaroo is Australia's trusted online marketplace for everyday essentials, top brands, and reliable nationwide delivery."
    },
    {
      "type": "text",
      "id": "abn_text",
      "label": "ABN text",
      "default": "ABN 00 000 000 000"
    },
    {
      "type": "text",
      "id": "location_text",
      "label": "Headquarters location",
      "default": "Headquartered in Sydney, Australia"
    },
    {
      "type": "link_list",
      "id": "shop_menu",
      "label": "Shop links menu"
    },
    {
      "type": "link_list",
      "id": "support_menu",
      "label": "Customer support menu"
    },
    {
      "type": "link_list",
      "id": "company_menu",
      "label": "Company menu"
    },
    {
      "type": "text",
      "id": "social_proof_text",
      "label": "Social proof text",
      "default": "Join 10,000+ Aussie shoppers"
    },
    {
      "type": "url",
      "id": "facebook_url",
      "label": "Facebook URL"
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram URL"
    },
    {
      "type": "url",
      "id": "tiktok_url",
      "label": "TikTok URL"
    },
    {
      "type": "checkbox",
      "id": "show_payment_row",
      "label": "Show payment row",
      "default": true
    },
    {
      "type": "link_list",
      "id": "legal_menu",
      "label": "Legal links menu"
    }
  ]
}
{% endschema %}
