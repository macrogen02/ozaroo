<section class="hero-banner section-spacing">
  <div class="page-width hero-grid">
    <div class="hero-content">
      <p class="eyebrow">{{ section.settings.eyebrow | default: 'Where Australia Shops.' }}</p>
      <h1>{{ section.settings.heading }}</h1>
      <p class="hero-subtext">{{ section.settings.subtext }}</p>
      {% if section.settings.button_label != blank %}
        <a class="button button--coral" href="{{ section.settings.button_link | default: '/collections/all' }}">
          {{ section.settings.button_label }}
        </a>
      {% endif %}
    </div>

    {% if section.settings.image != blank %}
      <div class="hero-image-wrap">
        {{ section.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 50vw, 100vw', widths: '375,550,750,990,1200,1400', alt: section.settings.heading }}
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Hero banner",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "Shop Smarter. Shop Ozaroo."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop Smarter. Shop Ozaroo."
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "Your trusted destination for everyday shopping across Australia."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Start shopping"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero image"
    }
  ],
  "presets": [
    {
      "name": "Hero banner"
    }
  ]
}
{% endschema %}
