<form class="ozh-search" action="{{ routes.search_url }}" method="get" role="search" data-search-wrap>
  <label for="OzhSearchInput" class="visually-hidden">Search products</label>

  <select name="type" aria-label="Search category">
    <option value="product">All Categories</option>
    {% for block in section.blocks %}
      {% if block.type == 'search_category' and block.settings.label != blank %}
        <option value="product">{{ block.settings.label }}</option>
      {% endif %}
    {% endfor %}
  </select>

  <input id="OzhSearchInput" type="search" name="q" placeholder="Search products, brands and categories" aria-label="Search products">
  <button type="submit" aria-label="Search">
    <svg viewBox="0 0 24 24" focusable="false" aria-hidden="true"><path d="M10.3 4a6.3 6.3 0 1 0 3.9 11.2l4 4a.9.9 0 0 0 1.3-1.3l-4-4A6.3 6.3 0 0 0 10.3 4Zm0 10.9a4.6 4.6 0 1 1 0-9.2 4.6 4.6 0 0 1 0 9.2Z" fill="currentColor"/></svg>
  </button>

  {% if section.settings.enable_predictive_search %}
    <div class="ozh-predictive" aria-label="Predictive search" data-search-dropdown hidden>
      <div>
        <p>Products</p>
        <a href="/collections/all">Trending product 1</a>
        <a href="/collections/all">Trending product 2</a>
      </div>
      <div>
        <p>Collections</p>
        <a href="/collections/electronics">Electronics</a>
        <a href="/collections/home-living">Home & Living</a>
      </div>
      <div>
        <p>Trending searches</p>
        <a href="{{ routes.search_url }}?q=wireless+earbuds">wireless earbuds</a>
        <a href="{{ routes.search_url }}?q=air+fryer">air fryer</a>
      </div>
    </div>
  {% endif %}
</form>
