<div class="payment-icons" role="list" aria-label="Accepted payment methods">
  <span class="payment-icon payment-icon--visa" role="listitem" aria-label="Visa" title="Visa">
    <svg class="payment-icon__logo" viewBox="0 0 64 24" focusable="false" aria-hidden="true">
      <text x="32" y="16" text-anchor="middle" font-size="12" font-weight="800" font-family="Arial, sans-serif" fill="#1A1F71">VISA</text>
    </svg>
  </span>

  <span class="payment-icon payment-icon--mastercard" role="listitem" aria-label="Mastercard" title="Mastercard">
    <svg class="payment-icon__logo" viewBox="0 0 64 24" focusable="false" aria-hidden="true">
      <circle cx="26" cy="12" r="7" fill="#EB001B"/>
      <circle cx="38" cy="12" r="7" fill="#F79E1B"/>
      <path d="M32 6.2a7 7 0 0 1 0 11.6 7 7 0 0 1 0-11.6Z" fill="#FF5F00"/>
    </svg>
  </span>

  <span class="payment-icon payment-icon--paypal" role="listitem" aria-label="PayPal" title="PayPal">
    <svg class="payment-icon__logo" viewBox="0 0 64 24" focusable="false" aria-hidden="true">
      <text x="32" y="16" text-anchor="middle" font-size="11" font-weight="700" font-family="Arial, sans-serif" fill="#003087">PayPal</text>
    </svg>
  </span>

  <span class="payment-icon payment-icon--apple" role="listitem" aria-label="Apple Pay" title="Apple Pay">
    <svg class="payment-icon__logo" viewBox="0 0 64 24" focusable="false" aria-hidden="true">
      <path d="M25.1 7.2c-.7.8-1.7 1.2-2.6 1.2 0-1 .3-1.9.9-2.6.7-.7 1.8-1.2 2.7-1.1 0 .9-.3 1.8-1 2.5Zm2.3 7.6c-.5 1.1-.8 1.5-1.4 2.4-.8 1-1.6 2-2.7 2-1 0-1.3-.6-2.4-1.3-1.1-.7-1.4-1.3-2.4-1.3-1.1 0-2 1-2.8 2-1-1.4-1.8-3.7-1.8-6.1 0-2.4 1.6-3.6 3.1-3.6 1.1 0 1.9.7 2.6.7.7 0 1.7-.8 2.9-.8 1 0 1.9.3 2.5.8-.7.5-1.3 1.3-1.3 2.4 0 1.4.8 2.1 1.6 2.5-.2.4-.3.7-.5 1.1Z" fill="#111"/>
      <text x="47" y="16" text-anchor="middle" font-size="10" font-weight="700" font-family="Arial, sans-serif" fill="#111">Pay</text>
    </svg>
  </span>

  <span class="payment-icon payment-icon--gpay" role="listitem" aria-label="Google Pay" title="Google Pay">
    <svg class="payment-icon__logo" viewBox="0 0 64 24" focusable="false" aria-hidden="true">
      <text x="30" y="16" text-anchor="middle" font-size="10" font-weight="700" font-family="Arial, sans-serif" fill="#4285F4">G</text>
      <text x="42" y="16" text-anchor="middle" font-size="10" font-weight="700" font-family="Arial, sans-serif" fill="#3C4043">Pay</text>
    </svg>
  </span>

  <span class="payment-icon payment-icon--afterpay" role="listitem" aria-label="Afterpay" title="Afterpay">
    <svg class="payment-icon__logo" viewBox="0 0 64 24" focusable="false" aria-hidden="true">
      <text x="32" y="16" text-anchor="middle" font-size="10" font-weight="700" font-family="Arial, sans-serif" fill="#00C3A6">afterpay</text>
    </svg>
  </span>

  <span class="payment-icon payment-icon--zip" role="listitem" aria-label="Zip" title="Zip">
    <svg class="payment-icon__logo" viewBox="0 0 64 24" focusable="false" aria-hidden="true">
      <text x="32" y="16" text-anchor="middle" font-size="12" font-weight="800" font-family="Arial, sans-serif" fill="#7B3FF2">zip</text>
    </svg>
  </span>
</div>
